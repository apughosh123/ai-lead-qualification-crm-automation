        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"openai/gpt-5.2\",\n  \"max_tokens\": 500,\n  \"response_format\": {\n    \"type\": \"json_object\"\n  },\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are an AI lead qualification assistant. Return ONLY a valid JSON object. Do not provide reasoning, explanation, markdown, code fences, or any other text.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Analyze this lead:\\n\\nName: {{$json['Full Name']}}\\nEmail: {{$json['Email']}}\\nCompany: {{$json['Company Name']}}\\nWebsite: {{$json['Company Website']}}\\nJob Title: {{$json['Job Title']}}\\nCompany Size: {{$json['Company Size']}}\\nNeed: {{$json['What do you need help with?']}}\\n\\nReturn a JSON object with exactly these fields:\\n{\\n  \\\"qualification\\\": \\\"Hot, Warm, or Cold\\\",\\n  \\\"lead_score\\\": 0,\\n  \\\"reason\\\": \\\"short explanation\\\",\\n  \\\"recommended_action\\\": \\\"next action for sales team\\\"\\n}\\n\\nThe lead_score must be a number from 0 to 100.\"\n    }\n  ]\n}",
        "options": {}
      },
